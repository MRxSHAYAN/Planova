{
  "services": {
    "frontend": {
      "root": "client",
      "framework": "vite"
    },
    "backend": {
      "root": "server",
      "entrypoint": "index.js"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "client"
      }
    }
  ]
}
